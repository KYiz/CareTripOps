# development | production. Production refuses to start without a strong DEMO_NONCE_SECRET
# and an https FRONTEND_ORIGIN, and disables /api/docs.
APP_ENV=development
MODEL_MODE=mock_llm
LLM_PROVIDER=gemini
GEMINI_REQUIREMENTS_MODEL=gemini-3.8-flash
MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
MAX_LIVE_SESSIONS_PER_CASE=2
GEMINI_PLANNING_ENABLED=true
GEMINI_PLANNER_MODEL=gemini-3.8-flash
GEMINI_REVIEWER_MODEL=gemini-3.8-flash
MAX_LLM_CALLS_PER_CASE=7
# New Cases per hour. Together with MAX_LLM_CALLS_PER_CASE this caps total model spend.
CASE_CREATE_LIMIT_PER_IP_PER_HOUR=30
CASE_CREATE_LIMIT_GLOBAL_PER_HOUR=300
FRONTEND_ORIGIN=http://localhost:8080
DEMO_NONCE_SECRET=caretrip-local-demo-only
# Accounts. Production needs a 32+ character AUTH_SECRET, EMAIL_BACKEND=smtp and AUTH_DEV_RETURN_CODE=false.
AUTH_SECRET=caretrip-local-auth-only
AUTH_DEV_RETURN_CODE=true
EMAIL_BACKEND=console
EMAIL_FROM=CareTrip <no-reply@caretrip.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Paying, cancelling and deleting the account need a code confirmed within this many minutes.
STEP_UP_MINUTES=10
# Sign-in by text message for accounts that verified a number: off | console (development) | twilio.
# Production refuses console. Twilio needs all three values below.
SMS_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Supplier: Compose points at the bundled simulator. Leave empty to run it in-process.
SUPPLIER_API_KEY=sim-local-key
# Payments: simulated, or stripe with test keys (see README, "Using real Stripe test keys").
PAYMENT_PROVIDER=simulated
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Comma-separated emails of travel advisors: the console at /advisor (help requests, evidence reviews, every trip,
# read-only trip access, notes). Viewing a traveler's health details is recorded on the trip.
ADVISOR_EMAILS=
# Printed on trip cards and the Help screen when set, e.g. 0800 123 456.
SUPPORT_PHONE=
# Shared rate limits across API processes. Compose runs Redis; production requires it.
REDIS_URL=redis://redis:6379/0
# Bearer token for /metrics (Prometheus). Nginx never exposes /metrics; scrape api:8000 on the internal network.
METRICS_TOKEN=
# Workflow worker and observability.
WORKER_CONCURRENCY=4
LOG_FORMAT=json
LOG_LEVEL=INFO
SENTRY_DSN=
